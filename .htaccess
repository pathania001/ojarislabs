# OjarisLabs — static hosting config (Apache / LiteSpeed, e.g. Hostinger)

DirectoryIndex index.html

# Friendly 404
ErrorDocument 404 /404.html

# OPTIONAL clean URLs: allow /services to serve services.html.
# The site already links to .html files directly, so this is a progressive
# enhancement — the site works correctly without it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # If "<name>.html" exists, serve it for "/<name>"
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# Keep HTML revalidating so new deployments pick up the latest asset version.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(llms\.txt|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "^sitemap\.xml$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|webp|png|jpe?g|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Long-cache static assets; generated HTML references versioned CSS/JS URLs.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
</IfModule>
