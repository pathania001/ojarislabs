# OjarisLabs — Hostinger Node.js environment variables
# Copy values into Hostinger's environment UI. NEVER commit real secrets.
# SMTP_PASS must stay empty here and be set securely in Hostinger only.

# HTTP
PORT=3000
HOST=0.0.0.0

# Contact form recipient (fixed; visitors cannot override)
CONTACT_TO_EMAIL=hello@ojarislabs.com

# Authenticated From mailbox (do NOT use the visitor's email as From)
CONTACT_FROM_EMAIL=hello@ojarislabs.com

# Hostinger SMTP (implicit TLS on port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@ojarislabs.com
SMTP_PASS=

# Set to true ONLY for local/API testing without sending real mail.
# Production must leave this unset or false.
CONTACT_DRY_RUN=false
