# OjarisLabs — environment variables for Hostinger Node.js
# Copy to .env locally if needed. NEVER commit real secrets.

# HTTP
PORT=3000
HOST=0.0.0.0

# Contact form recipient (fixed; visitors cannot override)
CONTACT_TO_EMAIL=hello@ojarislabs.com

# Authenticated From address allowed by your SMTP provider
# (do NOT use the visitor's email as From)
CONTACT_FROM_EMAIL=hello@ojarislabs.com

# SMTP (required for real delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional alias for CONTACT_FROM_EMAIL
# SMTP_FROM=

# Set to true ONLY for local testing without SMTP (logs instead of sending)
CONTACT_DRY_RUN=false
